#
# Opens the IMGx partition named by eve_root= through dm-verity, using the
# descriptor that verity-append (pkg/mkrootfs-squash) writes after the
# squashfs, and switches root to /dev/mapper/eve-root. A root hash signature
# in the descriptor is passed to the kernel, which checks it against its
# keyrings; with dm_verity.require_signatures=1 the kernel refuses a
# descriptor without one; without it, a signature that does not verify is
# dropped and the root hash alone is used. Every failure panics, so that
# pstore keeps the message and the boot falls back to the other partition;
# nothing mounts the partition unverified.

die() {
   echo "eve-verity: FATAL: $*" > /dev/kmsg
   echo "eve-verity: FATAL: $*" > /dev/console
   sleep 1
   echo c > /proc/sysrq-trigger
}

export DM_DISABLE_UDEV=1
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev

read -r CMDLINE < /proc/cmdline
for a in $CMDLINE; do
   case "$a" in
      eve_root=*) ROOT=${a#eve_root=};;
   esac
done
[ -n "$ROOT" ] || die "no eve_root= on the kernel command line"

i=0
while :; do
   DEV=$(blkid -t "$ROOT" -o device 2>/dev/null | head -1)
   [ -n "$DEV" ] && break
   i=$((i + 1))
   [ $i -gt 30 ] && die "root device $ROOT not found"
   sleep 1
done

BLK=4096
MIB=1048576
BYTES=$(dd if="$DEV" bs=8 skip=5 count=1 2>/dev/null | od -An -tu8 | tr -d ' ')
[ -n "$BYTES" ] || die "cannot read the squashfs superblock on $DEV"
DOFF=$(( ( (BYTES + BLK - 1) / BLK * BLK + MIB - 1) / MIB * MIB ))
dd if="$DEV" of=/desc bs=$BLK skip=$((DOFF / BLK)) count=1 2>/dev/null
[ "$(head -1 /desc)" = EVE-VERITY-1 ] || die "no verity descriptor on $DEV at $DOFF"
eval "$(sed -n '2,/^end$/p' /desc | grep -E '^(root_hash|salt|hash_offset|data_blocks|sig_len)=[0-9a-f]+$')"
[ -n "$root_hash" ] && [ -n "$salt" ] && [ -n "$hash_offset" ] && [ -n "$data_blocks" ] && [ -n "$sig_len" ] ||
   die "incomplete verity descriptor on $DEV"

set -- --no-superblock --hash=sha256 --data-block-size=$BLK --hash-block-size=$BLK \
   --data-blocks="$data_blocks" --hash-offset="$hash_offset" --salt="$salt" --panic-on-corruption
SIG=
if [ "$sig_len" -gt 0 ]; then
   dd if="$DEV" bs=$BLK skip=$((DOFF / BLK + 1)) count=$(( (sig_len + BLK - 1) / BLK )) 2>/dev/null |
      head -c "$sig_len" > /roothash.p7s
   SIG=--root-hash-signature=/roothash.p7s
fi
# Without Secure Boot the platform keyring may hold no key, and the kernel
# rejects a signature it cannot check even when it does not require one.
if ! veritysetup open "$DEV" eve-root "$DEV" "$root_hash" "$@" $SIG; then
   [ -n "$SIG" ] && [ "$(cat /sys/module/dm_verity/parameters/require_signatures)" = N ] ||
      die "veritysetup open failed on $DEV (descriptor or root hash signature rejected)"
   echo "eve-verity: root hash signature not verified, signatures not required" > /dev/kmsg
   veritysetup open "$DEV" eve-root "$DEV" "$root_hash" "$@" ||
      die "veritysetup open failed on $DEV"
fi

mkdir -p /newroot
mount -t squashfs -o ro /dev/mapper/eve-root /newroot || die "cannot mount /dev/mapper/eve-root"
umount /sys
umount /proc
exec switch_root /newroot /init
